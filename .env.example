# ==============================================================================
# DocuMind AI — Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env or use the dedicated backend/.env and frontend/.env files.

# Server / Backend Configuration
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1
APP_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Gemini API Configuration (Official @google/genai SDK)
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Supabase Database & Auth Configuration
# Obtain your keys at: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=documents

# Pipeline Limits & Worker
MAX_FILE_SIZE_MB=20
MAX_PDF_PAGES=100
MAX_BATCH_UPLOAD_FILES=20
MAX_CONCURRENT_JOBS=3
MAX_JOB_ATTEMPTS=3
JOB_POLL_INTERVAL_MS=3000

# Rate Limiting & Logs
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
MAX_EXPORT_ROWS=10000
LOG_LEVEL=info
ENABLE_DEMO_MODE=true

# Frontend Web Client Configuration
VITE_API_URL=/api/v1
VITE_APP_NAME="DocuMind AI"
VITE_ENABLE_DEMO_ACCOUNTS=true
