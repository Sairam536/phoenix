# ==============================================================================
# DocuMind AI — Environment Configuration Reference
# ==============================================================================
# 
# The application has been separated into standalone frontend and backend services.
# Each service maintains its own dedicated .env file:
#
# 1. Backend Service:
#    File: backend/.env
#    Template: backend/.env.example
#    Variables:
#      - PORT=4000
#      - NODE_ENV=development
#      - API_BASE_PATH=/api/v1
#      - FRONTEND_URL=http://localhost:5173
#      - GEMINI_API_KEY=your_gemini_api_key_here
#      - GEMINI_MODEL=gemini-1.5-flash
#      - SUPABASE_URL=https://your-project.supabase.co
#      - SUPABASE_ANON_KEY=your_supabase_anon_key
#      - SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
#      - SUPABASE_STORAGE_BUCKET=documents
#      - ENABLE_DEMO_MODE=true
#
# 2. Frontend Web Client:
#    File: frontend/.env
#    Template: frontend/.env.example
#    Variables:
#      - VITE_API_URL=/api/v1
#      - VITE_APP_NAME="DocuMind AI"
#      - VITE_ENABLE_DEMO_ACCOUNTS=true
#
# To get started:
#   cp backend/.env.example backend/.env
#   cp frontend/.env.example frontend/.env
# ==============================================================================
