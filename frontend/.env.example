# ==============================================================================
# DocuMind AI — Frontend (Web Client) Environment Configuration
# ==============================================================================

# Backend API Base URL
# Option A (Local dev via Vite reverse proxy): /api/v1
# Option B (Direct cross-origin server URL): http://localhost:4000/api/v1
VITE_API_URL=/api/v1

# Application Branding & Metadata
VITE_APP_NAME="DocuMind AI"
VITE_APP_ENV=development

# Demo Personas & Features
VITE_ENABLE_DEMO_ACCOUNTS=true

# Supabase Client Configuration (Optional for direct client auth/storage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
