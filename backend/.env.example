# ==============================================================================
# DocuMind AI — Backend API Environment Configuration
# ==============================================================================

NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1
APP_BASE_URL=http://localhost:5173
FRONTEND_URL=https://frontend-beryl-ten-26.vercel.app

# Gemini API Configuration (Official @google/genai SDK)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Supabase Project Configuration
# Settings -> API in your Supabase project dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=documents

# Limits
MAX_FILE_SIZE_MB=20
MAX_PDF_PAGES=100
MAX_BATCH_UPLOAD_FILES=20
MAX_CONCURRENT_JOBS=3
MAX_JOB_ATTEMPTS=3
JOB_POLL_INTERVAL_MS=3000

# Rate Limiting & Logs
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
MAX_EXPORT_ROWS=10000
LOG_LEVEL=info
ENABLE_DEMO_MODE=true
